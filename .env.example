# Copy to .env (gitignored). Never commit real keys.
ANTHROPIC_API_KEY=
# Optional comma-separated model list shown in the UI
# AI_MODELS=claude-sonnet-5-5,claude-opus-4-5
# Optional DB override (e.g. a copy when the live DB is locked)
# STOCKML_DB=/path/to/stockml.duckdb
# Optional Plunge Detector (src/config/watchlist.yaml); POST /api/plunge/scan works without this
# PLUNGE_ENABLED=1
# Telegram / Discord notifications
# TELEGRAM_BOT_KEY=
# TELEGRAM_CHAT_ID=
# DISCORD_WEBHOOK_Claude_AI=
